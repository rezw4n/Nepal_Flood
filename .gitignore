# environment
.venv/
__pycache__/
*.pyc

# inputs downloaded by scripts/download_sources.py and scripts/fetch_ext.py
sources/*
!sources/retrieval_log.json
sources_ext/*
!sources_ext/retrieval_log_ext.json
!sources_ext/references_verified.json
!sources_ext/crossref_authors.json
!sources_ext/s2/
sources_ext/s2/*
!sources_ext/s2/s2_log.json
!sources_ext/s2/chips.json

# building-level records and large intermediate products regenerated by the pipeline
data/*.csv
data/*.geojson
data/*.json
data/derived/*.parquet
data/derived/*_log.txt
data/derived/dem_utm30.tif
data/derived/slope_utm30.tif
data/derived/flowacc_utm30.tif
data/derived/hillshade_utm30.tif
data/derived/cems_latest_points.csv
data/derived/hot_*.csv
tables/undp_debris_records.csv
paper/*.html
checksums.csv

# office lock files
~$*
